# =============================================================================
# CampusFind Frontend - Environment Variables Template
#
# NOTE: In Vite, only variables prefixed with VITE_ are exposed to the client.
# Do NOT commit real secrets or production credentials into version control.
# =============================================================================

# Backend API Base URL (used in Sub-phase 1E onward)
VITE_API_BASE_URL=http://localhost:8080/campusfind-backend

# Cloudinary Direct Browser Upload Configuration (Sub-phase 7A)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
