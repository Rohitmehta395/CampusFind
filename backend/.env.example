# =============================================================================
# CampusFind Backend - Environment Variables Template
#
# NOTE: These values must be provided as environment variables to the runtime
# environment (or Tomcat container). Do NOT commit real secrets to Git.
# =============================================================================

# JDBC Database Connection
# serverTimezone should match the MySQL server/host timezone (Asia/Kolkata for IST) to prevent double timezone conversion
DB_URL=jdbc:mysql://localhost:3306/campusfind_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# JWT Authentication Secret (HMAC-SHA256 requires minimum 256 bits / 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_example_placeholder

