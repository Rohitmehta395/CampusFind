# JDBC Database Connection
DB_URL=jdbc:mysql://localhost:3306/campusfind_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=your_db_username
DB_PASSWORD=your_db_password
